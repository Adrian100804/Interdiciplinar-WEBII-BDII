<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Avaliar Jogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Biblioteca de Jogos</a>
    </div>
</nav>

<div class="container">
    <div class="card-home">
        <h1>Avaliar Jogo</h1>

        <h4 class="mb-4">
            <%= jogo.titulo %>
        </h4>

        <form action="/jogos/avaliar/<%= jogo.id_jogo %>" method="POST">
            <div class="mb-3">
                <label>Nome</label>
                <input type="text" name="nome_usuario" class="form-control" required>
            </div>

            <div class="mb-3">
                <label>Nota</label>
                <input type="number" name="nota" class="form-control" min="0" max="10" step="0.1" required>
            </div>

            <div class="mb-3">
                <label>Comentário</label>
                <textarea name="comentario" class="form-control" rows="4" required></textarea>
            </div>

            <button class="btn btn-success">Salvar Avaliação</button>
            <a href="/" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

</body>
</html>