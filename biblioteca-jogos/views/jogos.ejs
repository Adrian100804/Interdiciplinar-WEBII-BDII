<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Jogos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Biblioteca de Jogos</a>
        <a href="/" class="btn btn-outline-light btn-sm">Voltar</a>
    </div>
</nav>

<div class="container">
    <h1>Lista de Jogos</h1>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Ano</th>
                <th>Classificação</th>
                <th>Gênero</th>
                <th>Empresa</th>
                <th>Plataforma</th>
                <th>Nota</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            <% jogos.forEach(jogo => { %>
                <tr>
                    <td><%= jogo.titulo %></td>
                    <td><%= jogo.ano_lancamento %></td>
                    <td><%= jogo.classificacao_indicativa %></td>
                    <td><%= jogo.nome_genero %></td>
                    <td><%= jogo.nome_desenvolvedora %></td>
                    <td><%= jogo.plataformas %></td>

                    <td>
                        <% if (jogo.media_avaliacao) { %>
                            <%= Number(jogo.media_avaliacao).toFixed(1) %>
                        <% } else { %>
                            Sem avaliação
                        <% } %>
                    </td>

                    <td>
                        <a href="/jogos/avaliar/<%= jogo.id_jogo %>" class="btn btn-info btn-sm">Avaliar</a>
                        <a href="/jogos/editar/<%= jogo.id_jogo %>" class="btn btn-warning btn-sm">Editar</a>
                        <a href="/jogos/excluir/<%= jogo.id_jogo %>" class="btn btn-danger btn-sm" onclick="return confirm('Deseja excluir este jogo?')">Excluir</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</body>
</html>